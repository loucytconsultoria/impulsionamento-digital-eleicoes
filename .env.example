# Variáveis de ambiente opcionais (não há segredos neste projeto: os dados do TSE são públicos).
# Copie para .env se quiser fixar caminhos; os valores abaixo são os padrões.

# Pasta com os microdados brutos do TSE (somente leitura)
TSE_DADOS=./dados

# Pasta onde os pipelines em R escrevem tudo o que geram
IMPULSIONAMENTO_SAIDA=./execucao

# Raiz do repositório (normalmente detectada sozinha)
# IMPULSIONAMENTO_RAIZ=.

# Pasta de saída do módulo em Python (modelo de elasticidade)
ELASTICIDADE_SAIDA=./execucao/elasticidade
